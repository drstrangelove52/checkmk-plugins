import os
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

import requests

API_URL = "https://url.ecall.ch/api/sms"


def main():
    context = {
        var[7:]: value
        for var, value in os.environ.items()
        if var.startswith("NOTIFY_")
    }

    if not context.get("CONTACTPAGER"):
        sys.stderr.write("Contact's pager address is empty, not sending anything.\n")
        return 0

    username = context.get("PARAMETER_USERNAME")
    if not username:
        sys.stderr.write("Username is not set, not sending anything.\n")
        return 2

    password = _get_password(context)
    if not password:
        sys.stderr.write("Password is empty, not sending anything.\n")
        return 2

    text = get_text(context)
    return send_sms(username, password, text, context)


def _get_password(context):
    # Checkmk 2.4 serializes Password as a nested tuple:
    # explicit_password: ('cmk_postprocessed', 'explicit_password', ('uuid', 'actual_password'))
    #   → PARAMETER_PASSWORD_3_2 = actual password
    # stored_password: ('cmk_postprocessed', 'stored_password', ('store_id', ''))
    #   → Checkmk does NOT resolve stored passwords; must read from password store
    pw_type = context.get("PARAMETER_PASSWORD_2", "")

    if pw_type == "stored_password":
        store_id = context.get("PARAMETER_PASSWORD_3_1", "").strip()
        return _read_from_password_store(store_id)

    if context.get("PARAMETER_PASSWORD_3_2", "").strip():
        return context["PARAMETER_PASSWORD_3_2"].strip()
    if context.get("PARAMETER_PASSWORD_3", "").strip():
        return context["PARAMETER_PASSWORD_3"].strip()
    return context.get("PARAMETER_PASSWORD", "").strip()


def _read_from_password_store(store_id):
    try:
        import cmk.utils.password_store as pw
        store_path = Path(os.environ["OMD_ROOT"]) / "var/check_mk/stored_passwords"
        store = pw.load(store_path)
        return store.get(store_id, "")
    except Exception as e:
        sys.stderr.write("Error reading password store '%s': %s\n" % (store_id, e))
        return ""


def get_text(context):
    template = context.get("PARAMETER_MESSAGE_TEMPLATE", "")
    if template:
        return expand_template(template, context)
    return build_default_text(context)


def expand_template(template, context):
    def replace(match):
        return context.get(match.group(1), "")

    return re.sub(r"\$([A-Z0-9_]+)\$", replace, template)


def build_default_text(context):
    max_len = 160
    hostname = context.get("HOSTNAME", "")
    notification_type = context.get("NOTIFICATIONTYPE", "")
    what = context.get("WHAT", "HOST")

    message = hostname + " "

    if what == "SERVICE":
        if notification_type in ("PROBLEM", "RECOVERY"):
            message += context.get("SERVICESTATE", "")[:2] + " "
            avail_len = max_len - len(message)
            message += context.get("SERVICEDESC", "")[:avail_len] + " "
            avail_len = max_len - len(message)
            message += context.get("SERVICEOUTPUT", "")[:avail_len]
        else:
            message += context.get("SERVICEDESC", "")
    else:
        if notification_type in ("PROBLEM", "RECOVERY"):
            message += "is " + context.get("HOSTSTATE", "")

    if notification_type.startswith("FLAP"):
        message += " Started Flapping" if "START" in notification_type else " Stopped Flapping"
    elif notification_type.startswith("DOWNTIME"):
        what_label = notification_type[8:].title()
        message += " Downtime " + what_label + " " + context.get("NOTIFICATIONCOMMENT", "")
    elif notification_type == "ACKNOWLEDGEMENT":
        message += " Acknowledged " + context.get("NOTIFICATIONCOMMENT", "")
    elif notification_type == "CUSTOM":
        message += " Custom Notification " + context.get("NOTIFICATIONCOMMENT", "")

    return message.strip()[:max_len]


def send_sms(username, password, text, context):
    data = {
        "UserName": username,
        "Password": password,
        "Address": context["CONTACTPAGER"].replace(" ", ""),
        "Message": text,
    }

    resp = requests.post(API_URL, data=data, timeout=30)
    sys.stderr.write("HTTP %d: %s\n" % (resp.status_code, resp.text[:500]))

    try:
        root = ET.fromstring(resp.text.encode("utf-8"))
    except ET.ParseError:
        root = ET.fromstring("<empty />")

    response_data = {
        "AdditionalInfo": None,
        "ResultCode": None,
        "ResultText": None,
    }

    ns = "{http://schemas.datacontract.org/2004/07/eCallHttp.Models}Result"
    if root.tag == ns:
        for child in root:
            for key in response_data:
                if child.tag.endswith(key):
                    response_data[key] = child.text

    if resp.status_code == 200 and response_data["ResultCode"] == "0":
        sys.stdout.write("SMS successfully sent\n")
        return 0

    sys.stderr.write("%s\n" % response_data)
    return 2


sys.exit(main())
